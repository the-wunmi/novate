{
  "name": "novate",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @novate/db generate",
    "db:migrate": "pnpm --filter @novate/db migrate",
    "dev:api": "pnpm --filter @novate/api dev",
    "eval": "tsx --env-file=.env packages/agents/eval/run.ts",
    "reset-operator-key": "tsx --env-file=.env apps/api/src/reset-operator-key.ts",
    "demo": "tsx --env-file=.env packages/engine/test/demo.ts",
    "demo:live": "tsx --env-file=.env apps/api/src/demo-live.ts",
    "webhook:register": "tsx --env-file=.env apps/api/src/register-webhook.ts",
    "pay:airi": "tsx --env-file=.env apps/api/src/pay-with-airi.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/node": "^24",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
