DATABASE_URL=postgres://novate:novate@localhost:5433/novate
DBOS_SYSTEM_DATABASE_URL=postgres://novate:novate@localhost:5433/novate_dbos

# Local development only: a rail that settles with no money behind it.
NOVATE_ALLOW_MOCK_RAIL=

# Airwallex sandbox. The rail turns on with the client id and API key. Without a webhook secret
# every webhook is refused, and novate learns what happened by polling.
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_WEBHOOK_SECRET=
AIRWALLEX_BASE_URL=https://api.sandbox.airwallex.com
# pooled (default) or connected. Connected needs Airwallex to enable Connected Accounts.
AIRWALLEX_CUSTODY=pooled
# Only once Airwallex has enabled skipping 3DS on your merchant account.
AIRWALLEX_SKIP_3DS=false

# Metal (USD for agent-run firms). The endpoint URL is itself a credential.
METAL_RPC_URL=
METAL_PRIVATE_KEY=
# Defaults to *USDZ on testnet.
METAL_TOKEN_ADDRESS=

# Model agents (document reading, risk decisions). Without a key, cases go to rules, then people.
ANTHROPIC_API_KEY=

# Where to POST when a person is needed. Without these, alerts only reach the log.
NOVATE_ALERT_WEBHOOK_URL=
NOVATE_ALERT_WEBHOOK_SECRET=
# Who a buyer's Airi mandate names as the merchant when funding a deal by card.
NOVATE_MERCHANT_NAME=novate
NOVATE_MERCHANT_URL=https://novate.example
NOVATE_MERCHANT_COUNTRY=US

