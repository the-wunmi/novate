DATABASE_URL=postgres://novate:novate@localhost:5433/novate
DBOS_SYSTEM_DATABASE_URL=postgres://novate:novate@localhost:5433/novate_dbos
# In production DATABASE_URL connects as novate_app, which can only read and append to the audit
# tables, and this is the owner's connection that boot migrates and grants with. Leave unset to use
# DATABASE_URL for both.
# NOVATE_MIGRATION_DATABASE_URL=
# The API's port. The live demo uses its own, 4100 unless NOVATE_DEMO_PORT is set.
PORT=4000
NOVATE_DEMO_PORT=4100

# People sign in to the console with accounts; keys are for machines.
# Encrypts two-factor secrets at rest: 32 random bytes, `openssl rand -base64 32`. Losing it means
# everyone turns two-factor sign-in on again.
NOVATE_SECRET_KEY=
# Where people reach this server. Invite links point here, and it is an allowed console origin.
# Empty: http://localhost:$PORT.
NOVATE_PUBLIC_URL=http://localhost:4000
# Who the first boot invites as house and platform admins. Links are printed once at first boot.
NOVATE_ADMIN_EMAIL=admin@localhost
NOVATE_PLATFORM_ADMIN_EMAIL=platform@localhost
# How invite and reset links reach people. `inviter` (or empty): returned once to whoever invited.
# `notification`: sent as a `user_invite` notification to NOVATE_ALERT_WEBHOOK_URL, never shown to
# the inviter. Production should use `notification`.
NOVATE_INVITE_DELIVERY=
# Other origins the console may be served from and call with a session, comma-separated. Usually
# empty: `pnpm dev:console` forwards to the API as the API's own origin.
NOVATE_ALLOWED_ORIGINS=
# Behind proxies you run, how many of them append to X-Forwarded-For. The caller's address is the
# entry that many from the right, which sign-in rate limits key on. 0 or empty: no proxy.
NOVATE_TRUST_PROXY_HOPS=

# Local development only: a rail that settles with no money behind it.
NOVATE_ALLOW_MOCK_RAIL=

# Airwallex sandbox. The rail turns on with the client id and API key. Without a webhook secret
# every webhook is refused, and novate learns what happened by polling.
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_WEBHOOK_SECRET=
AIRWALLEX_BASE_URL=https://api.sandbox.airwallex.com
# pooled (default) or connected. Connected needs Airwallex to enable Connected Accounts.
AIRWALLEX_CUSTODY=pooled
# Only once Airwallex has enabled skipping 3DS on your merchant account.
AIRWALLEX_SKIP_3DS=false

# Metal (USD for agent-run firms). The endpoint URL is itself a credential.
METAL_RPC_URL=
METAL_PRIVATE_KEY=
# Defaults to *USDZ on testnet.
METAL_TOKEN_ADDRESS=

# Model agents (document reading, risk decisions). Without a key, cases go to rules, then people.
ANTHROPIC_API_KEY=

# Where to POST when a person is needed. Without these, alerts only reach the log.
NOVATE_ALERT_WEBHOOK_URL=
NOVATE_ALERT_WEBHOOK_SECRET=
# Who a buyer's Airi mandate names as the merchant when funding a deal by card.
NOVATE_MERCHANT_NAME=novate
NOVATE_MERCHANT_URL=https://novate.example
NOVATE_MERCHANT_COUNTRY=US

# `pnpm pay:airi <dealId>`: a buyer paying a deal by card through Airi. The buyer's API key, the
# server to call, and which Airi card to use.
NOVATE_BUYER_KEY=
NOVATE_API_URL=http://localhost:4000
AIRI_PAYMENT_METHOD_ID=
AIRI_CARD_NAME=Novate Buyer
